# Sao chép thành .env (KHÔNG commit .env)
POSTGRES_USER=aipi
POSTGRES_PASSWORD=aipi
POSTGRES_DB=aipi

# Dùng khi chạy backend trực tiếp trên máy (không qua Docker)
DATABASE_URL=postgresql+psycopg://aipi:aipi@localhost:5432/aipi

# Khóa HMAC tạo pseudonym người đăng (FR-30). Tạo bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTER_HMAC_KEY=
